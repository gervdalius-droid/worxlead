# WorxLead — Apache / LiteSpeed (Hostinger web hosting)
RewriteEngine On

# Visada HTTPS.
# X-Forwarded-Proto sąlyga būtina: be jos serveryje, kuris TLS nutraukia
# proxy lygyje (Hostinger taip daro), gaunamas begalinis peradresavimas —
# naršyklė rodo ERR_TOO_MANY_REDIRECTS. Laikiname domene SSL gali dar nebūti.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# be www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

DirectoryIndex index.html

# Vienas puslapis — vienas adresas. /uzklausa.html ir /index.html peradresuojami
# į švarų variantą, kad paieškos sistemos nerastų to paties turinio dviem adresais.
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Tikras failas (paveikslėliai, wl-*.js, robots.txt ...) — atiduodam kaip yra.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Iš anksto sugeneruotas puslapis: /duk -> /duk.html, /kategorijos/elektra ->
# /kategorijos/elektra.html. Jame jau įrašytas visas turinys, todėl jį mato ir
# robotai, kurie nevykdo JavaScript (Bing, GPTBot, ClaudeBot, socialiniai tinklai).
# Tikriname per DOCUMENT_ROOT — REQUEST_FILENAME .htaccess faile ne visuose
# serveriuose (LiteSpeed) yra pilnas kelias.
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]

# Asmeninis užklausų puslapis — jį piešia JavaScript, todėl failo nėra.
RewriteRule ^mano/?$ /index.html [L]

# Visi kiti adresai neegzistuoja: serveris grąžina tikrą 404 kodą, o
# ErrorDocument parodo gražų puslapį. Taip paieškos sistemos jų neindeksuoja.

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # HSTS: naršyklė metus laiko jungsis tik per HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Turinio politika: svetimas skriptas nepaleidžiamas net jei kaip nors
  # patektų į puslapį. Parašus (sha256) perskaičiuoja scripts/build-dist.py.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'sha256-CGoTgfMB9AUwtTG4Q8n4AQwM7Hu+HZQSScOMLXepc9k=' 'sha256-CgYrAhGFMTYKYv/2jb+gMIaEZnR0PkGV3rSlkneUYfY=' https://connect.facebook.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://www.facebook.com; font-src 'self' data:; connect-src 'self' https://szqgchsvoinzvhvmvsuq.supabase.co https://www.facebook.com https://connect.facebook.net; media-src 'self' blob:; worker-src 'self' blob:; upgrade-insecure-requests"

  # HTML niekada neįkešuojamas — kad pakeitimai matytųsi iškart
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|png|jpg|svg|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # wl-*.js keliauja su ?v=<santrauka>, todėl galima laikyti ilgai —
  # pasikeitus failui pasikeičia ir adresas.
  <FilesMatch "^wl-.*\.js$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

ErrorDocument 404 /index.html

<IfModule mod_headers.c>
  <FilesMatch "\.(png|jpg|svg|webp|gif)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
